<Project>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <!-- net6.0 matches the CoreWF packages; silence the EOL advisory since the target is deliberate. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CoreWF / UiPath.Workflow brings the runtime + bundled System.Xaml.
         net6.0 (NOT net6.0-windows) keeps the System.Xaml identity coming from the
         package, avoiding a clash with the WindowsDesktop System.Xaml.
         IMPORTANT: use the UiPath-Official feed build (System.Activities AssemblyVersion 6.0.0.0)
         that ships with Studio, NOT the nuget.org 6.0.3 (AssemblyVersion 6.0.3.0) which Studio
         cannot load. This version pairs with UiPath.Activities.Api 24.10.1 / Studio 24.10. -->
    <UiPathWorkflowVersion>6.0.0-20240401-07</UiPathWorkflowVersion>
    <!-- UiPath Studio/Robot design + runtime API (project settings, etc). From the UiPath-Official feed. -->
    <UiPathActivitiesApiVersion>24.10.1</UiPathActivitiesApiVersion>
    <!-- Modern Studio designer view-models (renders activity properties in the card). -->
    <SystemActivitiesViewModelsVersion>1.0.0-20250625.2</SystemActivitiesViewModelsVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shared brand assets (icon + readme) used for NuGet packaging and activity icons. -->
    <RepoAssetsDir>$(MSBuildThisFileDirectory)assets\</RepoAssetsDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Versioning is driven by MinVer (see Directory.Build.targets). Each packable project sets its
         own <MinVerTagPrefix> so the three packages version and release INDEPENDENTLY from their own
         git tags, e.g. `M.Super.Activities-v1.2.0`, `M.Super.Extensions-v1.1.0`. On a tagged commit the
         version is exactly the tag; in between it auto-increments to the next patch -alpha.0.<height>.
         Floor untagged/CI builds at 1.0 so a pre-tag build never appears to go backwards to 0.x.
         For a quick local feed pack with a single shared version, pack.ps1 passes -p:MinVerVersionOverride. -->
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

</Project>
